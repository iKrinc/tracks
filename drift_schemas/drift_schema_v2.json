  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"opening_balance_paise\" INTEGER NOT NULL DEFAULT 0, \"currency\" TEXT NOT NULL DEFAULT 'INR', \"color\" INTEGER NOT NULL, \"icon\" TEXT NOT NULL, \"match_hints\" TEXT NOT NULL DEFAULT '', \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"parent_id\" INTEGER NULL REFERENCES categories (id), \"color\" INTEGER NOT NULL, \"icon\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"amount_paise\" INTEGER NOT NULL, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id), \"to_account_id\" INTEGER NULL REFERENCES accounts (id), \"category_id\" INTEGER NULL REFERENCES categories (id), \"note\" TEXT NOT NULL DEFAULT '', \"merchant\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, \"tags\" TEXT NOT NULL DEFAULT '', \"attachment_path\" TEXT NULL, \"source\" TEXT NOT NULL DEFAULT 'manual', \"raw_source_text\" TEXT NULL, \"ref_no\" TEXT NULL, \"linked_recurring_id\" INTEGER NULL, \"linked_debt_id\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rules\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"keyword\" TEXT NOT NULL UNIQUE, \"category_id\" INTEGER NULL REFERENCES categories (id), \"account_id\" INTEGER NULL REFERENCES accounts (id), \"hits\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "txn_occurred_at",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX txn_occurred_at ON transactions (occurred_at)"
        }
      ]
    }
